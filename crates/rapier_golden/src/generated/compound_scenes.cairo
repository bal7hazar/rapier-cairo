/// Every scene: `(id, start, linvel)`; its ground is `ground_kind(index)` and its compound
/// `body(index)`.
pub fn scenes() -> Span<(felt252, Vec2Raw, Vec2Raw)> {
    SCENES.span()
}

/// `0` when the ground of scene `index` is the convex `ground_convex(index)`, `1` when it is the
/// composite `ground(index)`.
pub fn ground_kind(index: u32) -> u32 {
    match index {
        0 => 0,
        1 => 1,
        2 => 1,
        _ => core::panic_with_felt252('compound_scenes: no scene'),
    }
}

/// The convex ground of scene `index`.
pub fn ground_convex(index: u32) -> Sh1ShapeRaw {
    match index {
        0 => Sh1ShapeRaw::Other(ShapeRaw::HalfSpace(Vec2Raw { x: 0, y: 4294967296 })),
        _ => core::panic_with_felt252('compound_scenes: no convex'),
    }
}

/// The samples of scene `index`, one per step: `(step, x, y, re, im, vx, vy, w, manifolds with
/// solver contacts)`.
pub fn samples(index: u32) -> Span<(u32, i64, i64, i64, i64, i64, i64, i64, u32)> {
    match index {
        0 => SAMPLES0.span(),
        1 => SAMPLES1.span(),
        2 => SAMPLES2.span(),
        _ => core::panic_with_felt252('compound_scenes: no scene'),
    }
}

/// The collision events of scene `index`: `(step, started, collider1, collider2)`, colliders 0
/// (ground) and 1 (the body's).
pub fn events(index: u32) -> Span<(u32, bool, u32, u32)> {
    match index {
        0 => EVENTS0.span(),
        1 => EVENTS1.span(),
        2 => EVENTS2.span(),
        _ => core::panic_with_felt252('compound_scenes: no scene'),
    }
}
