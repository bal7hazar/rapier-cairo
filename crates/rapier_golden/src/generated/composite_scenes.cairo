/// Every scene: `(id, dynamic shape, start, linvel)`; its ground is `ground(index)`.
pub fn scenes() -> Span<(felt252, Sh1ShapeRaw, Vec2Raw, Vec2Raw)> {
    SCENES.span()
}

/// The samples of scene `index`, one per step: `(step, x, y, re, im, vx, vy, w, manifolds with
/// solver contacts)`.
pub fn samples(index: u32) -> Span<(u32, i64, i64, i64, i64, i64, i64, i64, u32)> {
    match index {
        0 => SAMPLES0.span(),
        1 => SAMPLES1.span(),
        2 => SAMPLES2.span(),
        _ => core::panic_with_felt252('composite_scenes: no scene'),
    }
}

/// The collision events of scene `index`: `(step, started, collider1, collider2)`, colliders 0
/// (ground) and 1 (the body's).
pub fn events(index: u32) -> Span<(u32, bool, u32, u32)> {
    match index {
        0 => EVENTS0.span(),
        1 => EVENTS1.span(),
        2 => EVENTS2.span(),
        _ => core::panic_with_felt252('composite_scenes: no scene'),
    }
}
