/// Every scene: `(id, kind, num_solver_iterations, max_ccd_substeps, ccd_enabled)`.
pub fn scenes() -> Span<(felt252, felt252, u32, u32, bool)> {
    SCENES.span()
}

/// The samples of scene `index`, one per step: `(step, x, y, vx, vy, ccd_active, other_x, other_y,
/// other_angle)`.
pub fn samples(index: u32) -> Span<(u32, i64, i64, i64, i64, bool, i64, i64, i64)> {
    match index {
        0 => PLANK_BULLET_SUB1.span(),
        1 => PLANK_BULLET_SUB4.span(),
        2 => PLANK_AUTO_SUB1.span(),
        3 => PLANK_AUTO_SUB4.span(),
        4 => PLANK_OFF_SUB1.span(),
        5 => PLANK_OFF_SUB4.span(),
        6 => PLANK_BULLET_SPLIT4.span(),
        7 => BOX_BULLET.span(),
        8 => SLOW_BULLET.span(),
        _ => core::panic_with_felt252('ccd_scenes: no such scene'),
    }
}
