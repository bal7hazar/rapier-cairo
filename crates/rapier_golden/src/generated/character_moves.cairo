/// Every scene collider, in handle order per scene: `(scene, kind (0 standalone fixed, 1
/// velocity-based kinematic body, 2 dynamic body), pose, linvel, shape)`.
pub fn colliders() -> Span<(u32, u8, PoseRaw, Vec2Raw, ShapeRaw)> {
    COLLIDERS.span()
}

/// Every case: `(id, scene, character shape, pose, desired translation, dt, options)`, the
/// options `(bool, bool, i64, i64, bool, i64, i64, bool, i64, i64, i64)` = `(slide, autostep?, max
/// height (absolute), min width (absolute), include dynamic bodies, max climb angle, min slide
/// angle, snap?, snap (relative), offset (relative), normal nudge)`.
pub fn cases() -> Span<
    (
        felt252,
        u32,
        ShapeRaw,
        PoseRaw,
        Vec2Raw,
        i64,
        (bool, bool, i64, i64, bool, i64, i64, bool, i64, i64, i64),
    ),
> {
    CASES.span()
}

/// Upstream's answer per case: `(translation, grounded, sliding down, collisions)`.
pub fn results() -> Span<(Vec2Raw, bool, bool, u32)> {
    RESULTS.span()
}

/// Every collision event, case by case in callback order: `(case, collider index, toi, normal1,
/// witness1, translation applied, translation remaining)` (world space).
pub fn hits() -> Span<(u32, u32, i64, Vec2Raw, Vec2Raw, Vec2Raw, Vec2Raw)> {
    HITS.span()
}
